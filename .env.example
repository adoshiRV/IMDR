# IMDR Environment Configuration

# MSSQL Connection (Windows Auth — no username/password needed)
IMDR_MSSQL_HOST=localhost
IMDR_MSSQL_PORT=1433
IMDR_MSSQL_DATABASE=IMDR
IMDR_MSSQL_DRIVER=ODBC+Driver+17+for+SQL+Server

# Connection Pool
IMDR_POOL_SIZE=5
IMDR_MAX_OVERFLOW=10
IMDR_POOL_TIMEOUT=30

# HTTP
IMDR_HTTP_TIMEOUT=30
IMDR_HTTP_RETRIES=3

# API Keys
IMDR_BIDFX_API_KEY=
IMDR_CITIVELOCITY_API_KEY=
# FRED (St. Louis Fed) — free key, register at https://fred.stlouisfed.org/docs/api/api_key.html
IMDR_ECON_FRED_KEY=
# BPS Indonesia (Badan Pusat Statistik) — free application key, register at
# https://webapi.bps.go.id/developer/ → "Daftar" / Sign up. Approval is
# typically instant once email is verified. See docs/admin/econ/indonesia/index.md.
IMDR_BPS_API_KEY=
# data.gov.in OGD — free key, register at https://data.gov.in/user/register
# Used for Agmarknet daily mandi price data (resource 35985678-…).
IMDR_DATA_GOV_IN_API_KEY=

# Qdrant (vector DB) — local Windows Service, see docs/admin/qdrant/
IMDR_QDRANT_URL=http://127.0.0.1:6333
IMDR_QDRANT_API_KEY=
IMDR_QDRANT_TIMEOUT=30

# Research RAG ingest + embeddings
# See docs/admin/research/index.md. Voyage / Gemini keys are per-provider.
IMDR_VOYAGE_KEY=
IMDR_GEMINI_KEY=
IMDR_RESEARCH_EMBED=false
IMDR_RESEARCH_EMBED_MODEL=gemini-embedding-2
# Drop single-name equity coverage at discovery (see
# docs/admin/research/relevance_filter.md). Default ON. Flip to "false"
# for backfills that legitimately want single-name notes.
IMDR_RESEARCH_DROP_SINGLE_NAME_EQUITY=true
# Inter-report pacing (seconds). A random sleep in [min, max] is
# inserted before every ingest_one() so successive PDF downloads look
# like a human reader. Set max=0 to disable (e.g., for retry runs).
IMDR_RESEARCH_PACING_SECONDS_MIN=3
IMDR_RESEARCH_PACING_SECONDS_MAX=10
# Parallel-vendor knobs (see docs/admin/development/parallel_vendor_ingest.md).
# Concurrent vendors. Hard-cap 3 (RAM budget). Default 1 = today's serial.
IMDR_RESEARCH_VENDOR_PARALLEL=1
# Cross-vendor cap on simultaneous embed API calls (Voyage/Gemini).
# Default 4; lower if you see sustained 429s under high vendor_parallel.
IMDR_RESEARCH_EMBED_CONCURRENCY=4

# BidFX (basic auth for Historical Tick API)
IMDR_BIDFX_USERNAME=
IMDR_BIDFX_PASSWORD=
IMDR_BIDFX_BASE_URL=
IMDR_BIDFX_MAX_WORKERS=16
IMDR_BIDFX_TIMEOUT_CONNECT=3
IMDR_BIDFX_TIMEOUT_READ=7

# Research portal auth (consumed by src/imdr/research/auth/).
# Barclays Live uses programmatic form login; profile is wiped per run
# (PingFederate session-token poisoning) and re-logged in ~5s.
IMDR_BARCLAYS_USERNAME=
IMDR_BARCLAYS_PASSWORD=
# JPM Janus needs SSO cookies (one-time headed re-auth) PLUS a per-user
# 'janus_user' GraphQL header — username only, no password.
IMDR_RESEARCH_JPM_USERNAME=
# UBS Neo — programmatic two-step form (email then password). Persistent
# profile cookies last days-to-weeks. Headed Chrome required (UBS rejects
# the HeadlessChrome UA).
IMDR_RESEARCH_UBS_USERNAME=
IMDR_RESEARCH_UBS_PASSWORD=
# ANZ Research — programmatic form login. Falls back to PROFILE_ONLY if
# MFA fires (see src/imdr/research/auth/loginflows/anz.py).
IMDR_RESEARCH_ANZ_USERNAME=
IMDR_RESEARCH_ANZ_PASSWORD=
# Nomura NomuraNow — programmatic form login (same MFA fallback policy).
IMDR_RESEARCH_NOMURA_USERNAME=
IMDR_RESEARCH_NOMURA_PASSWORD=
# Standard Chartered research — programmatic form login (same MFA fallback).
IMDR_RESEARCH_STANC_USERNAME=
IMDR_RESEARCH_STANC_PASSWORD=

# Email (Outlook COM)
IMDR_EMAIL_ENABLED=false
IMDR_EMAIL_TO=
IMDR_EMAIL_ANOMALY_TO=

# Teams (Workflows webhook — "Post to a channel when a webhook request is received")
# See docs/admin/ops/prediction/teams_integration.md for setup steps.
IMDR_TEAMS_POLYMARKET_WEBHOOK=

# Anomaly Detection
IMDR_ANOMALY_PCT_THRESHOLD=50.0

# Parquet Archive
IMDR_PARQUET_BATCH_DIR=data/parquet
IMDR_PARQUET_RETENTION_DAYS=90

# Run Logs (JSONL)
IMDR_RUN_LOG_DIR=data/logs

# Cache (pair availability)
IMDR_CACHE_DIR=data/cache

# Logging
IMDR_LOG_LEVEL=INFO
IMDR_LOG_FORMAT=console
