{# Weekly preview — deep on Tier-1 events, medium on the rest. #}
{% extends "_base.html.j2" %}

{% block body_main %}

  {# §0 Story of the Week #}
  <h2 id="story">§0 · Story of the Week</h2>
  <div class="callout">{{ cfg.story_callout | safe }}</div>

  {# Compact KPI mini-table #}
  {%- with kpis=cfg.kpis, heading="Markets snapshot · 5-day change, verified vs IMDR" %}
  {%- include "_components/kpi_mini.html.j2" %}
  {%- endwith %}

  {# §1 Event Calendar #}
  <h2 id="calendar">§1 · Event Calendar (UTC)</h2>
  {%- with events=cfg.events %}
  {%- include "_components/event_calendar.html.j2" %}
  {%- endwith %}

  {%- if cb_section %}
  <h4>Central bank speakers / blackouts</h4>
  <div class="tbl-scroll">
    <table>
      <thead><tr><th class="left">Date</th><th class="left">Event</th></tr></thead>
      <tbody>
      {%- for row in cb_section %}
        <tr><td class="left">{{ row[0] }}</td><td class="left">{{ row[1] | safe }}</td></tr>
      {%- endfor %}
      </tbody>
    </table>
  </div>
  {%- endif %}

  {# §2 Cross-asset markets snapshot — charts only, KPI was at top #}
  {%- if cross_asset_charts %}
  <h2 id="snapshot">§2 · Cross-Asset Markets Snapshot</h2>
  <p>{{ cross_asset_lead | safe }}</p>
  <div class="chart-grid-2">
    {%- for cf in cross_asset_charts %}
    <div class="chart-card">
      <img src="charts/{{ cf }}" alt="chart">
      {%- if chart_captions and cf in chart_captions %}
      <div class="chart-caption">{{ chart_captions[cf] | safe }}</div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  {%- endif %}

  {# §3..N deep dives (US CPI, ECB, etc.) #}
  {%- for s in cfg.deep_dives %}
  {%- with s=s, number=s.consensus_number, text=s.consensus_text, reaction_caption=reaction_captions.get(s.section_id, "") %}
  {%- include "_components/deep_dive.html.j2" %}
  {%- endwith %}
  {%- endfor %}

  {# medium-depth sections (BoC, Japan, China, etc.) #}
  {%- for s in cfg.medium_sections %}
  {%- with s=s %}
  {%- include "_components/medium_section.html.j2" %}
  {%- endwith %}
  {%- endfor %}

  {# §N · Trade ideas + supporting visualisations #}
  {%- if cfg.trades %}
  {%- with trades=cfg.trades, section_num=trades_section_num, title="Trade Ideas — Week", lead="10 trade ideas across rates, FX, and equities — derived directly from the vendor reports above. Text and table first; supporting chart-visualisations are at the bottom as augmentation." %}
  {%- include "_components/trade_table.html.j2" %}
  {%- endwith %}
  {%- endif %}

  {# §N+1 · Tail risks #}
  {%- if cfg.tail_risks %}
  {%- with risks=cfg.tail_risks, section_num=risks_section_num, title="Tail Risks — What Breaks the Consensus" %}
  {%- include "_components/tail_risks.html.j2" %}
  {%- endwith %}
  {%- endif %}

  {# Appendix #}
  {%- if cfg.appendix %}
  {%- with title="Appendix · Reports Referenced", appendix=cfg.appendix, build_sources=build_sources %}
  {%- include "_components/appendix.html.j2" %}
  {%- endwith %}
  {%- endif %}

{% endblock %}
