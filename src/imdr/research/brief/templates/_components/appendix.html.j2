{# Appendix — references table + build-source bullets. #}
<h2>{{ title }}</h2>

<p>Every cited report ID below links directly to its SharePoint PDF.</p>

<div class="tbl-scroll">
  <table>
    <thead><tr><th class="left">Topic</th><th class="left">Reports (vendor, id)</th></tr></thead>
    <tbody>
    {%- for topic, refs in appendix.items() %}
      <tr><td class="left">{{ topic }}</td><td class="left">{{ refs | safe }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
</div>

{%- if build_sources %}
<h4>Build sources &amp; verification</h4>
<ul class="footer-note">
{%- for line in build_sources %}
  <li>{{ line | safe }}</li>
{%- endfor %}
</ul>
{%- endif %}
