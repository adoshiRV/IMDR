{# Compact 8-cell markets snapshot. Renders the KPI mini-table only. #}
<h4>{{ heading }}</h4>
<div class="kpi-mini">
  {%- for k in kpis %}
  <div class="cell">
    <span class="lbl">{{ k.label }}</span>
    <span class="val">{{ k.value }}</span>
    {%- if k.change or k.context %}
    <span class="meta">
      {%- if k.change %}<span class="chg {{ k.change_sign }}">{{ k.change }}</span>{% endif %}
      {%- if k.change and k.context %}<span class="sep">·</span>{% endif %}
      {%- if k.context %}<span class="ctx">{{ k.context }}</span>{% endif %}
    </span>
    {%- endif %}
  </div>
  {%- endfor %}
</div>
