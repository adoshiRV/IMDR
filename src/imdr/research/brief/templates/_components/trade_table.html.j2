{# Trade-ideas table + optional supporting visualisations (charts AFTER table). #}
<h2 id="trades">{{ section_num }} · {{ title }}</h2>

<p>{{ lead | safe }}</p>

<div class="tbl-scroll">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th class="left">Trade</th>
        <th class="left">Type</th>
        <th class="left">Thesis</th>
        <th class="left">Risk</th>
        <th class="left">Owner banks</th>
      </tr>
    </thead>
    <tbody>
    {%- for t in trades %}
      <tr>
        <td>{{ t.idx }}</td>
        <td class="left">{{ t.name }}</td>
        <td class="left"><span class="trade-tag {{ t.kind }}">{{ t.kind | upper }}</span></td>
        <td class="left">{{ t.thesis | safe }}</td>
        <td class="left">{{ t.risk | safe }}</td>
        <td class="left">{{ t.owners | safe }}</td>
      </tr>
    {%- endfor %}
    </tbody>
  </table>
</div>

{%- if supporting_chart_files %}
<h3>Supporting visualisations</h3>
<p style="font-size:13.5px;color:var(--muted);">Charts below augment specific trades from the table above.</p>
<div class="chart-grid-2">
  {%- for cf in supporting_chart_files %}
  <div class="chart-card">
    <img src="charts/{{ cf }}" alt="chart">
    {%- if supporting_captions and cf in supporting_captions %}
    <div class="chart-caption">{{ supporting_captions[cf] | safe }}</div>
    {%- endif %}
  </div>
  {%- endfor %}
</div>
{%- endif %}
