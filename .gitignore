# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.venv/

# Secrets
.env

# Tool caches
.claude/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Test / coverage
.coverage
htmlcov/

# IDE / notebooks
.ipynb_checkpoints/
*.db

# Runtime data outputs (auto-created; only .gitkeep markers tracked).
# Covers every per-vendor + per-country runtime tree under data/, including
# data/econ/{vendor}/, data/econ/{cc}/govt/, data/parquet/, etc.
data/*
!data/gaps/
data/gaps/*
!data/gaps/.gitkeep

# Runtime logs (research-ingest etc.)
logs/

# SQL migrations — tracked via DBA channel, not git
migrations/*
!migrations/.gitkeep

# Playground (exploration / one-off scripts)
playground/*

# Playwright persistent profiles spawned by per-run scrapers (hundreds of MB).
# Always-fresh in our resolvers (rmtree before/after each run) but the dir
# itself shouldn't be tracked.
scripts/**/profile_*/
playground/**/profile_*/

# RBI Bulletin headed-Chrome profile + xlsx download cache (never commit — contains cookies)
playground/econ/in/rbi/_profile/
playground/econ/in/rbi/_downloads/
