# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.venv/

# Secrets
.env

# Tool caches
.claude/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Test / coverage
.coverage
htmlcov/

# IDE / notebooks
.ipynb_checkpoints/
*.db

# Runtime data outputs (auto-created; only .gitkeep markers tracked)
data/*
!data/gaps/
data/gaps/*
!data/gaps/.gitkeep

# Per-country govt-filings runtime state (seen.json + daily snapshots +
# last-run log) — generated by scripts/econ/{cc}/govt/ingest_filings.py
# on every cron run; per-machine state, not source.
scripts/econ/*/govt/data/*
!scripts/econ/*/govt/data/.gitkeep

# Runtime logs (research-ingest etc.)
logs/

# SQL migrations — tracked via DBA channel, not git
migrations/*
!migrations/.gitkeep

# Playground (exploration / one-off scripts)
playground/*
